# For `docker compose` without Portainer: copy to .env and fill in. .env is ignored by git; never
# commit it. In Portainer, set these as the stack's environment variables instead.

# Claude API key (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=sk-ant-REPLACE-ME

# Frigate+ refresh token, only needed for the very first start. Afterwards it's stored in ./config,
# and you can paste a new one on the web page when it expires.
FRIGATE_PLUS_REFRESH_TOKEN=

# Docker network SWAG is attached to
SWAG_NETWORK=swag_default

# URL path the app is served under (must match the SWAG location)
FRIGATE_LABELER_BASE_PATH=/frigate-labeler
